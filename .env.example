# # Copy to .env.development (or .env) and fill in secrets. Never commit real credentials.
# # This project loads, in order: .env.${DJANGO_ENV} at repo root, then env/.env.${DJANGO_ENV}, then .env

# DJANGO_ENV=development
# SECRET_KEY=change-me
# # Avoid raw $ in SECRET_KEY values used with Docker Compose (Compose treats $VAR as interpolation).
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# # Database (sqlite by default). For Postgres set DB_ENGINE=postgres and DB_* vars.
# DB_ENGINE=sqlite

# # Redis — use redis://redis:6379/1 inside Docker Compose; use redis://127.0.0.1:6379/1 on host
# REDIS_URL=redis://127.0.0.1:6379/1
# # Set to 0 so Django cache + OTP/rate limits use Redis (required for OTP reset in multi-instance setups)
# USE_LOC_MEM_CACHE=1

# # ---------------------------------------------------------------------------
# # Gmail SMTP (use an App Password, not your normal Google password)
# # ---------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=30
# EMAIL_HOST_USER=your.account@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=Your App Name <your.account@gmail.com>
# SERVER_EMAIL=your.account@gmail.com

# # Optional: public URL for reset links in email (e.g. https://app.example.com). If empty, API request host is used.
# PASSWORD_RESET_PUBLIC_BASE_URL=
# # Frontend origin for emailed links: {FRONTEND_URL}/reset-password/{uid}/{token}/
# FRONTEND_URL=http://localhost:3000

# # Token lifetime for Django password-reset tokens (seconds). Default 900 = 15 minutes.
# PASSWORD_RESET_TIMEOUT=900

# # Logging
# LOG_LEVEL=INFO

# # Staff-only POST /api/auth/email/test/ — keep False in production unless you need it briefly
# ENABLE_EMAIL_TEST_API=False

# # ---------------------------------------------------------------------------
# # Google Sign-In (POST /api/auth/google/ with JSON {"id_token":"..."})
# # ---------------------------------------------------------------------------
# # GOOGLE_CLIENT_ID must match the OAuth client that mints the ID token (JWT "aud").
# # For multiple clients (Web + Android + iOS), use comma-separated IDs.
# GOOGLE_CLIENT_ID=
# # Used by OAuth Playground / authorization-code flows; not required to verify ID tokens.
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PROJECT_ID=
# # Legacy per-platform IDs (merged with GOOGLE_CLIENT_ID into GOOGLE_OAUTH2_ALLOWED_AUDIENCES)
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# #
# # --- Google OAuth 2.0 Playground (manual backend testing) ---
# # 1) Google Cloud Console > APIs & Services > Credentials > your Web client:
# #    Add Authorized redirect URI: https://developers.google.com/oauthplayground
# # 2) Open https://developers.google.com/oauthplayground
# #    Gear icon > "Use your own OAuth credentials" > paste Web Client ID + Client Secret.
# # 3) Step 1: select scope "openid" (and "email", "profile" if offered).
# # 4) Authorize > Step 2 "Exchange authorization code for tokens" > copy "id_token".
# # 5) POST http://127.0.0.1:8000/api/auth/google/  Body: {"id_token":"<paste>"}
# #    The id_token "aud" must equal one of the IDs in GOOGLE_CLIENT_ID (or legacy vars).
